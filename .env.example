# Groundwork — environment variables
# Copy to Vercel → Project → Settings → Environment Variables (do NOT commit real keys).
# Everything is optional: with none set, Groundwork runs as the deterministic advisor.

# --- AI tailoring (api/tailor.js) --- set EITHER provider (server-only) ---
# Gemini: free tier, no card. Key: https://aistudio.google.com/app/apikey  (starts with AIza...)
GEMINI_API_KEY=
# Groq: free, fast. Key: https://console.groq.com/keys  (starts with gsk_...)
GROQ_API_KEY=
# Optional: force one when both keys are set ("gemini" or "groq"). Default prefers Gemini.
AI_PROVIDER=
# Optional model override (default: Gemini gemini-2.5-flash / Groq llama-3.3-70b-versatile)
TAILOR_MODEL=

# --- Database: session capture + short links (api/capture.js, api/share.js) ---
# Powered by Neon Postgres. If you added Neon from the Vercel Storage tab, this is
# set for you AUTOMATICALLY across environments — you don't paste anything here.
# It's listed only so the variable is documented.
DATABASE_URL=
